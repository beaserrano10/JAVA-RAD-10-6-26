import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int n = input.nextInt();

        for (int i = 1; i <= n; i++) {
            if (i % 30 != 0) {
                continue;
            }
            
            // Print if divisible by 30
            System.out.println(i);
            
            // Stop/break if i reaches or exceeds 30 (or custom condition)
            if (i >= 30) {
                break;
            }
        }

        input.close();
    }
}
